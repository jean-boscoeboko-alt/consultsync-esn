# Port d'écoute du serveur Express
PORT=3000

# Chaîne de connexion PostgreSQL pour Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/consultsync?schema=public"

# Clé secrète pour la signature des jetons JWT (utiliser une chaîne aléatoire longue en production)
JWT_SECRET="changez-moi-avec-une-cle-secrete-tres-longue-et-aleatoire"

# Durée de validité du token JWT
JWT_EXPIRES_IN="24h"

# Origine autorisée pour le Front-end (CORS)
CLIENT_URL="http://localhost:5500"
